          contract: {
            id: "GET /analytics/reporting/2027-03-beta/reports"
            json: "{\"operationId\":\"get-/analytics/reporting/2027-03-beta/reports\",\"parameters\":[{\"description\":\"A cursor token for pagination. Use the value from the previous response's paging.next.after field.\",\"explode\":true,\"in\":\"query\",\"name\":\"after\",\"required\":false,\"schema\":{\"example\":null,\"type\":\"string\"},\"style\":\"form\"},{\"description\":\"Whether to retrieve archived reports only. Default false.\",\"explode\":true,\"in\":\"query\",\"name\":\"archived\",\"required\":false,\"schema\":{\"example\":null,\"type\":\"boolean\"},\"style\":\"form\"},{\"description\":\"Filter to reports that are a part of the specified business units.\",\"explode\":true,\"in\":\"query\",\"name\":\"businessUnitIds\",\"required\":false,\"schema\":{\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"style\":\"form\"},{\"description\":\"Filter to reports created after a specific date and time.\",\"explode\":true,\"in\":\"query\",\"name\":\"createdAfter\",\"required\":false,\"schema\":{\"example\":null,\"format\":\"date-time\",\"type\":\"string\"},\"style\":\"form\"},{\"description\":\"Filter to reports created before a specific date and time.\",\"explode\":true,\"in\":\"query\",\"name\":\"createdBefore\",\"required\":false,\"schema\":{\"example\":null,\"format\":\"date-time\",\"type\":\"string\"},\"style\":\"form\"},{\"description\":\"Filter to reports on the specified dashboard.\",\"explode\":true,\"in\":\"query\",\"name\":\"dashboardId\",\"required\":false,\"schema\":{\"example\":null,\"type\":\"string\"},\"style\":\"form\"},{\"description\":\"Filter to reports with the specified IDs.\",\"explode\":true,\"in\":\"query\",\"name\":\"ids\",\"required\":false,\"schema\":{\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"style\":\"form\"},{\"description\":\"The maximum number of results to display per page. Default 25, max 100.\",\"explode\":true,\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"example\":null,\"format\":\"int32\",\"type\":\"integer\"},\"style\":\"form\"},{\"description\":\"Filter to reports that are on, or not on, any dashboard. Unset by default.\",\"explode\":true,\"in\":\"query\",\"name\":\"onDashboard\",\"required\":false,\"schema\":{\"example\":null,\"type\":\"boolean\"},\"style\":\"form\"},{\"description\":\"Filter to only reports that are favorited by the requesting user. Default false.\",\"explode\":true,\"in\":\"query\",\"name\":\"onlyFavorites\",\"required\":false,\"schema\":{\"example\":null,\"type\":\"boolean\"},\"style\":\"form\"},{\"description\":\"Filter to reports owned by the specified users.\",\"explode\":true,\"in\":\"query\",\"name\":\"ownerUserIds\",\"required\":false,\"schema\":{\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"style\":\"form\"},{\"description\":\"Additionally properties to include in the response. Refer to the response details for available fields.\",\"explode\":true,\"in\":\"query\",\"name\":\"properties\",\"required\":false,\"schema\":{\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"style\":\"form\"},{\"description\":\"Filter to reports whose name or description contains the search string.\",\"explode\":true,\"in\":\"query\",\"name\":\"q\",\"required\":false,\"schema\":{\"example\":null,\"type\":\"string\"},\"style\":\"form\"},{\"description\":\"Sort field and direction. Supported fields are `name`, `updatedAt`, and `lastViewedAt`. Defaults to `-updatedAt`\",\"explode\":true,\"in\":\"query\",\"name\":\"sort\",\"required\":false,\"schema\":{\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"style\":\"form\"},{\"description\":\"Filter to reports tagged with the specified tags.\",\"explode\":true,\"in\":\"query\",\"name\":\"tagIds\",\"required\":false,\"schema\":{\"example\":null,\"items\":{\"example\":null,\"type\":\"string\"},\"type\":\"array\"},\"style\":\"