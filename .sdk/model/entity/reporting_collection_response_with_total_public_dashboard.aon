IFIC`, ignored otherwise.\\n\\nDashboards can have one or two specific permission configurations: one for VIEW grants and/or one for EDIT grants. Specific users and/or teams receive either VIEW or EDIT permissions based on which configuration they appear in. A given user or team cannot appear in both VIEW and EDIT configurations.\",\"example\":null,\"items\":{\"example\":null,\"properties\":{\"grants\":{\"description\":\"An array of grants detailing the users and/or teams to grant the specific permission to. At least one grantee must be specified.\",\"example\":null,\"items\":{\"example\":null,\"properties\":{\"grantType\":{\"description\":\"The type of entity to grant permissions to, either `USER` or `TEAM`.\",\"enum\":[\"TEAM\",\"USER\"],\"example\":null,\"type\":\"string\"},\"granteeId\":{\"description\":\"The ID of the user or team to grant permissions to.\",\"example\":null,\"type\":\"string\"}},\"required\":[\"grantType\",\"granteeId\"],\"type\":\"object\"},\"type\":\"array\"},\"permissionType\":{\"description\":\"The type of permission granted, either `VIEW` or `EDIT`.\",\"enum\":[\"EDIT\",\"VIEW\"],\"example\":null,\"type\":\"string\"}},\"required\":[\"permissionType\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"permissionType\"],\"type\":\"object\"},\"tags\":{\"description\":\"Array of objects representing the tags that the dashboard is tagged with.\\n\\nOnly returned when requested by including the `tags` field in the `properties` query parameter.\",\"example\":null,\"items\":{\"example\":null,\"properties\":{\"createdAt\":{\"description\":\"The date and time when the tag was created, in ISO 8601 format. May be absent.\",\"example\":null,\"format\":\"date-time\",\"type\":\"string\"},\"createdByUserId\":{\"description\":\"The ID of the user who created the tag. May be absent.\",\"example\":null,\"type\":\"string\"},\"id\":{\"description\":\"The ID for the tag.\",\"example\":null,\"type\":\"string\"},\"name\":{\"description\":\"The name of the