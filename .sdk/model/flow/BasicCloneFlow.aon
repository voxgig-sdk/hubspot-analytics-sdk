# BasicCloneFlow

main: kit: flow: BasicCloneFlow:
{
  entity: "clone",
  kind: "basic",
  name: "BasicCloneFlow",
  step: [
    {
      input: {
        ref: "clone_ref01"
      }

      match: {
        dashboard_id: "dashboard01"
      }

      op: "create"
    }
  ],
  "key$": "BasicCloneFlow"
}