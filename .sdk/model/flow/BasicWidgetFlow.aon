# BasicWidgetFlow

main: kit: flow: BasicWidgetFlow:
{
  entity: "widget",
  kind: "basic",
  name: "BasicWidgetFlow",
  step: [
    {
      input: {
        ref: "widget_ref01"
      }

      match: {
        dashboard_id: "dashboard01"
      }

      op: "create"
    }

    {
      data: {
        dashboard_id: "dashboard01"
      }

      input: {
        ref: "widget_ref01",
        srcdatavar: "widget_ref01_data",
        suffix: "_up0",
        textfield: "archivedAt"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-widget_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "widget_ref01",
        suffix: "_rm0"
      }

      match: {
        dashboard_id: "dashboard01",
        id: "widget01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicWidgetFlow"
}